 right ascension coordinate type                CTYPE2  = 'DEC--TAN'           / declination coordinate type                    CRPIX1  =    2.983499007717569 / [pixel] reference pixel along image axis 1     CRPIX2  =    2.598229700083266 / [pixel] reference pixel along image axis 2     CRVAL1  =            294.57624 / [deg] right ascension at reference pixel       CRVAL2  =             38.45697 / [deg] declination at reference pixel           CUNIT1  = 'deg     '           / physical unit in column dimension              CUNIT2  = 'deg     '           / physical unit in row dimension                 CDELT1  =   -0.001101634038871 / [deg] pixel scale in RA dimension              CDELT2  =    0.001101634038871 / [deg] pixel scale in Dec dimension             PC1_1   =  -0.8609011209844021 / linear transformation element cos(th)          PC1_2   =   0.5044518186402224 / linear transformation element -sin(th)         PC2_1   =   0.5065289580707425 / linear transformation element sin(th)          PC2_2   =   0.8647689354336033 / linear transformation element cos(th)          WCSNAMEP= 'PHYSICAL'           / name of world coordinate system alternate P    WCSAXESP=                    2 / number of WCS physical axes                    CTYPE1P = 'RAWX    '           / physical WCS axis 1 type CCD col               CUNIT1P = 'PIXEL   '           / physical WCS axis 1 unit                       CRPIX1P =                    1 / reference CCD column                           CRVAL1P =                  497 / value at reference CCD column                  CDELT1P =                  1.0 / physical WCS axis 1 step                       CTYPE2P = 'RAWY    '           / physical WCS axis 2 type CCD row               CUNIT2P = 'PIXEL   '           / physical WCS axis 2 units                      CRPIX2P =                    1 / reference CCD row                              CRVAL2P =                  207 / value at reference CCD row                     CDELT2P =                  1.0 /