    1 / extension version number (not format version)  TELESCOP= 'Kepler  '           / telescope                                      INSTRUME= 'Kepler Photometer'  / detector type                                  OBJECT  = 'KIC 8676148'        / string version of target id                    KEPLERID=              8676148 / unique Kepler target identifier                RADESYS = 'ICRS    '           / reference frame of celestial coordinates       RA_OBJ  =           285.803220 / [deg] right ascension                          DEC_OBJ =            44.873430 / [deg] declination                              EQUINOX =               2000.0 / equinox of celestial coordinate system         WCSAXES =                    2 / number of WCS axes                             CTYPE1  = 'RA---TAN'           / right ascension coordinate type                CTYPE2  = 'DEC--TAN'           / declination coordinate type                    CRPIX1  =   3.2900586948388764 / [pixel] reference pixel along image axis 1     CRPIX2  =    2.739924594326112 / [pixel] reference pixel along image axis 2     CRVAL1  =            285.80322 / [deg] right ascension at reference pixel       CRVAL2  =             44.87343 / [deg] declination at reference pixel           CUNIT1  = 'deg     '           / physical unit in column dimension              CUNIT2  = 'deg     '           / physical unit in row dimension                 CDELT1  =   -0.001103194370781 / [deg] pixel scale in RA dimension              CDELT2  =    0.001103194370781 / [deg] pixel scale in Dec dimension             PC1_1   =   0.5928366325757969 / linear transformation element cos(th)          PC1_2   =   0.8032817296981641 / linear transformation element -sin(th)         PC2_1   =   0.8058677392138736 / linear transformation element sin(th)          PC2_2   =  -0.5948707437394085 / linear transformation element cos(th)          WCSNAMEP= 'PHYSICAL'           / name of world coordinate system alternate P    WCSAXESP=                